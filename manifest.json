{
    "manifest_version": 3,
    "name": "Roblox Friend Stalker",
    "version": "1.0",
    "description": "Tracks friend changes for Roblox users",
    "permissions": [
      "storage",
      "alarms",
      "notifications",
      "tabs"
    ],
    "host_permissions": [
      "https://friends.roblox.com/*",
      "https://users.roblox.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    }
  }